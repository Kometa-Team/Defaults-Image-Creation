#####################################
# Global notes
#####################################
# All scripts read only from: ./config/.env (next to each script).
# Booleans: true/false/1/0/yes/no (case-insensitive).
# Use absolute paths or forward slashes for cross-platform paths.

#####################################
# Orchestrator (orchestrator.py)
#####################################
# Path to Kometa logs for name discovery (scan_kometa_logs.py / find_and_download_missing_people.py)
ORCH_LOGS_DIR=

# Single style fallback (used if ORCH_STYLES/--styles is not set)
ORCH_STYLE=transparent

# Multiple styles for README + sync_md (comma list). If set, overrides ORCH_STYLE.
# Example: ORCH_STYLES=transparent,diiivoycolor
ORCH_STYLES=transparent,diiivoycolor

# README grid images are slow to build; keep disabled unless explicitly needed.
ORCH_GRID_IMAGES=false

# Optional push customization
ORCH_COMMIT_MESSAGE=                   # leave empty to let orchestrator build a nice default
ORCH_GIT_USER_NAME=                    # optional git author override for push
ORCH_GIT_USER_EMAIL=                   # optional git author override for push

# Background-removal verification (sel_remove_bg.py outputs)
# Extensions to count as produced by sel_remove_bg (comma list)
ORCH_BG_EXTS=png
# If true, continue pipeline even when remove_bg produced 0 files
ORCH_CONTINUE_IF_EMPTY=false
ORCH_RECOVER_EDGE_CHOPS=true           # after poster_ps1, retry top-edge transparent chops from TMDB alternates

# Hard requirements (fail-fast when set true)
ORCH_REQUIRE_POWERSHELL=true          # if true and no pwsh/powershell found -> exit 2
ORCH_REQUIRE_BG_OUTPUT=true           # if true and SEL_DOWNLOAD_DIR missing -> exit 2


#####################################
# TMDB & poster generation (tmdb_people.py, prep_people_dirs.py)
#####################################
TMDB_KEY=                              # REQUIRED — your TMDB v3 API key
PERSON_DEPTH=10                        # Optional: graph depth for person credits
PEOPLE_LIST=./config/people_list.txt   # Optional: one name per line
POSTER_DIR=./config/posters            # Where tmdb_people.py saves raw posters
POSTERS_INPUT_DIR=./config/posters     # Where audit_people_images.py looks for input posters


#####################################
# Original image resolver (resolve_original_images.py)
#####################################
# Optional source of imported/generated style folders. Defaults to ./config/people_dirs.
PEOPLE_IMPORT_DIR=

# Compare these style outputs against candidate originals.
ORIGINAL_RESOLVER_STYLES=transparent,rainier

# A candidate at or above this visual match score is accepted.
ORIGINAL_RESOLVER_THRESHOLD=0.82

# TMDB is searched first. If no match is found, Google Custom Search is tried
# when these keys are set.
ORIGINAL_RESOLVER_TMDB_LIMIT=50
ORIGINAL_RESOLVER_GOOGLE_LIMIT=30
GOOGLE_API_KEY=
GOOGLE_CSE_ID=


#####################################
# People-Images repo location
# (ensure_people_repo.py, sync_people_images.py, update_people_repos.py)
#####################################
# *** IMPORTANT ***
# Clone the 7 People-Images repos into a folder (e.g., Kometa-People-Images).
# This folder should NOT be inside create_people_posters/config.
# Example: /data/Kometa-People-Images or D:/Kometa-People-Images
PEOPLE_IMAGES_DIR=
PEOPLE_BRANCH=master                   # Optional; script can auto-detect per repo if left empty
SYNC_PREFLIGHT=true                    # source QA before sync; fatal issues block, grayscale reports only

# Use a dedicated Python for colorize_noncolor.py (optional)
COLORIZE_PYTHON=D:/Defaults-Image-Creation/create_people_posters/.venv-colorize/Scripts/python.exe
COLORIZE_PYTHON=/home/bullmoose20/Defaults-Image-Creation/create_people_posters/.venv-colorize/bin/python


#####################################
# Adobe Express Remove Background (sel_remove_bg.py)
#####################################
# Chrome profile so you're signed into Adobe Express
SEL_USER_DATA_DIR=./config/chrome-profile    # Chrome user-data dir (persist login)
SEL_PROFILE_DIR=Default                      # Chrome profile folder name

# I/O folders used by sel_remove_bg.py
SEL_SRC_DIR=./config/people_dirs/Downloads   # input JPGs (from tmdb/get_missing flows)
SEL_ORIG_DIR=./config/people_dirs/original   # original JPGs preserved here
SEL_DOWNLOAD_DIR=./config/sel_downloads      # where PNGs are downloaded

# Timeouts & behavior
SEL_MAX_WAIT_READY_SEC=60              # page to become interactive
SEL_PROC_TIMEOUT=120                   # max seconds per file
SEL_MAX_WAIT_DL_SEC=20                 # wait for a download to complete
SEL_DL_BUTTON_TIMEOUT=12               # wait for the "Remove background" button
SEL_PROMPT_FOR_LOGIN=true              # pause in terminal if Adobe requires login before download
SEL_LOGIN_WAIT_SEC=900                 # how long to wait for you to finish Adobe login
SEL_RELOAD_EACH_FILE=true              # reload tool page between files

# Size enforcement (input JPGs)
SEL_EXPECT_WIDTH=2000
SEL_EXPECT_HEIGHT=3000
SEL_ENFORCE_SIZE=true

# Advanced (rarely changed)
SEL_TOOL_URL=https://new.express.adobe.com/tools/remove-background
# SEL_INPUT_EXTS=jpg,jpeg,webp         # optional: comma list


#####################################
# Edge-chop recovery (recover_edge_chops.py)
#####################################
EDGE_CHOP_THRESHOLD=0.06
EDGE_CHOP_TMDB_LIMIT=12
EDGE_CHOP_RECOVER_WARNINGS=headchop    # explicit modes: headchop,grayscale,face-chin,face-side,all
EDGE_CHOP_EXHAUSTED_FILE=./config/edge_chop_recovery/exhausted_names.txt
EDGE_CHOP_ATTEMPTED_FILE=./config/edge_chop_recovery/attempted_candidates.csv
EDGE_CHOP_STAGE_FOR_ORCHESTRATOR=false
EDGE_CHOP_RUN_ORCHESTRATOR=false
EDGE_CHOP_REPORT_EDGES=top             # top is the reliable head-chop signal
EDGE_CHOP_RETRY_EDGES=top              # optional diagnostics only: bottom,left,right
EDGE_CHOP_FACE_CROP_SIDE_MARGIN=0.02
EDGE_CHOP_FACE_CROP_CHIN_MARGIN=0.015
EDGE_CHOP_PRECHECK_REMBG=true          # local rembg pass filters bad TMDB alternates before Adobe/Selenium
EDGE_CHOP_REMBG_MODEL=u2net
REMBG_HOME=./config/models/rembg       # model cache used by rembg during recovery
EDGE_CHOP_REMBG_ALPHA_MATTING=false
EDGE_CHOP_REMBG_POST_PROCESS_MASK=true
EDGE_CHOP_REJECT_GRAYSCALE=true        # do not accept B/W or near-grayscale TMDB alternates
EDGE_CHOP_COLORIZE_GRAYSCALE=true      # run DeOldify first when a recovery alternate is B/W
EDGE_CHOP_GRAYSCALE_SAT_THRESHOLD=35
EDGE_CHOP_GRAYSCALE_SAT_QUANTILE=0.95
EDGE_CHOP_GRAYSCALE_COLORFULNESS_CUTOFF=12.0
IMAGE_CHECK_FACE_CROP_CHECKS=chin,left,right
IMAGE_CHECK_FACE_CROP_SIDE_MARGIN=0.02
IMAGE_CHECK_FACE_CROP_CHIN_MARGIN=0.015
COMPTREE_FACE_CROP_CHECKS=chin,left,right
COMPTREE_FACE_CROP_SIDE_MARGIN=0.02
COMPTREE_FACE_CROP_CHIN_MARGIN=0.015
FACE_CROP_MODEL_HOME=./config/models/opencv
FACE_CROP_MODEL_URL=https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2026may.onnx
# Whole-tree recovery is intentionally not automatic; use --all/--names/--limit
# for backlog cleanup.
