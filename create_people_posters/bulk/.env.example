# Copy to .env beside compose.yaml; no credentials are used or needed.
# Absolute path on the Linux Docker host, outside the repository:
PEOPLE_ROOT=/srv/people-bulk-data
PEOPLE_IMAGE=kometa-people-bulk:local
PEOPLE_UID=1000
PEOPLE_GID=1000
PEOPLE_BATCH=canary-01
PEOPLE_PIN=source-01
PEOPLE_STYLES=diiivoy
PEOPLE_WORKERS=2
PEOPLE_CPUS=4
PEOPLE_MEMORY=8g
