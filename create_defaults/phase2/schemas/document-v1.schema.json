{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package A prototype YAML envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles", "definitions"],
  "properties": {
    "schema_version": {"const": 1},
    "profiles": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"}, "additionalProperties": {"type": "object"}},
    "definitions": {"type": "array", "minItems": 1, "items": {"type": "object", "properties": {"extends": {"type": "string"}}}}
  }
}
