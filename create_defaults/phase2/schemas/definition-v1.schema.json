{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package A fully inherited poster definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "display_name", "source", "assets", "caption", "font", "typography", "background", "layout", "effects", "output", "languages", "variants", "dependencies", "overrides"],
  "$defs": {
    "path": {"type": "string", "format": "relative-artwork-path"},
    "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "language": {"enum": ["ar", "en", "da", "de", "es", "fr", "it", "nb_NO", "nl", "pt-br", "sv"]},
    "nullablePath": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
    "nullableKey": {"type": ["string", "null"], "minLength": 1}
  },
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
    "category": {"enum": ["Aspect", "AudioLanguage", "Awards", "Based", "Chart", "ContentRating", "Country", "Decade", "Franchise", "Genre", "Network", "Playlist", "Resolution", "Seasonal", "Separators", "Streaming", "Studio", "SubtitleLanguage", "Universe", "VideoFormat", "Year"]},
    "display_name": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "line", "row_sha256"],
      "properties": {"path": {"const": "create_default_posters.ps1"}, "line": {"type": "integer", "minimum": 1}, "row_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "assets": {
      "type": "object", "additionalProperties": false, "required": ["logo", "avg_color_image", "dom_color_image"],
      "properties": {"logo": {"$ref": "#/$defs/nullablePath"}, "avg_color_image": {"$ref": "#/$defs/nullablePath"}, "dom_color_image": {"$ref": "#/$defs/nullablePath"}}
    },
    "caption": {
      "type": "object", "additionalProperties": false, "required": ["mode", "key", "template_key", "text", "case", "fallback", "direction"],
      "properties": {"mode": {"enum": ["none", "literal", "translation"]}, "key": {"$ref": "#/$defs/nullableKey"}, "template_key": {"$ref": "#/$defs/nullableKey"}, "text": {"type": "string"}, "case": {"enum": ["exact", "upper", "lower"]}, "fallback": {"enum": ["error", "literal"]}, "direction": {"enum": ["auto", "ltr", "rtl"]}}
    },
    "font": {
      "type": "object", "additionalProperties": false, "required": ["family", "file"],
      "properties": {"family": {"type": "string", "minLength": 1}, "file": {"$ref": "#/$defs/path"}}
    },
    "typography": {
      "type": "object", "additionalProperties": false, "required": ["mode", "point_size", "box", "minimum", "maximum", "color"],
      "properties": {"mode": {"enum": ["fixed", "fit"]}, "point_size": {"type": ["integer", "null"], "minimum": 10, "maximum": 500}, "box": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 10000}}, "minimum": {"type": "integer", "minimum": 1, "maximum": 1000}, "maximum": {"type": "integer", "minimum": 1, "maximum": 1000}, "color": {"$ref": "#/$defs/hex"}}
    },
    "background": {
      "type": "object", "additionalProperties": false, "required": ["mode", "hex", "scope"],
      "properties": {"mode": {"enum": ["explicit", "legacy_random", "asset"]}, "hex": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hex"}]}, "scope": {"enum": ["historical-unreviewed", "global", "category", "collection", "related", "approved-duplicate", "template"]}}
    },
    "layout": {
      "type": "object", "additionalProperties": false, "required": ["logo_offset", "logo_resize", "text_offset"],
      "properties": {"logo_offset": {"type": "integer", "minimum": -10000, "maximum": 10000}, "logo_resize": {"type": "integer", "minimum": 0, "maximum": 10000}, "text_offset": {"type": "integer", "minimum": -10000, "maximum": 10000}}
    },
    "effects": {
      "type": "object", "additionalProperties": false, "required": ["gradient", "clean", "white_wash", "avg_color", "dom_color", "border", "border_width", "border_color"],
      "properties": {"gradient": {"type": "integer", "minimum": 0, "maximum": 4}, "clean": {"type": "boolean"}, "white_wash": {"type": "boolean"}, "avg_color": {"type": "boolean"}, "dom_color": {"const": false}, "border": {"type": "boolean"}, "border_width": {"type": "integer", "minimum": 0, "maximum": 1000}, "border_color": {"$ref": "#/$defs/hex"}}
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["directory", "filename"],
      "properties": {"directory": {"$ref": "#/$defs/path"}, "filename": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "^[^/]+\\.jpg$"}]}}
    },
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/language"}},
    "variants": {"type": "array", "maxItems": 0},
    "dependencies": {"type": "array", "maxItems": 0},
    "overrides": {"type": "array", "maxItems": 0}
  }
}
