{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kometa:bulk:definition:1",
  "title": "Bulk logical poster definition v1",
  "type": "object", "additionalProperties": false,
  "required": ["id", "category", "display_name", "source", "composer", "caption", "layout", "languages", "applicability", "output", "dependencies", "overrides", "generator", "color_assignment"],
  "$defs": {
    "path": {"type": "string", "format": "artwork-path"},
    "nullablePath": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 160},
    "language": {"enum": ["ar", "en", "da", "de", "es", "fr", "it", "nb_NO", "nl", "pt-br", "sv"]},
    "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "offset": {"anyOf": [{"type": "integer", "minimum": -1500, "maximum": 1500}, {"type": "string", "pattern": "^\\+-[0-9]+$"}]},
    "fallback": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["id", "reviewer", "reason", "policy_version", "text", "language", "key"], "properties": {"id": {"$ref": "#/$defs/id"}, "reviewer": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "policy_version": {"type": "string", "minLength": 1}, "text": {"type": ["string", "null"]}, "language": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/language"}]}, "key": {"type": ["string", "null"]}}}]},
    "caption": {"type": "object", "additionalProperties": false, "required": ["mode", "key", "template_key", "text", "case", "direction", "fallback"], "properties": {"mode": {"enum": ["none", "shared", "translation"]}, "key": {"type": ["string", "null"]}, "template_key": {"type": ["string", "null"]}, "text": {"type": "string", "maxLength": 16384}, "case": {"enum": ["exact", "upper", "lower"]}, "direction": {"enum": ["auto", "ltr", "rtl"]}, "fallback": {"$ref": "#/$defs/fallback"}}},
    "composer": {
      "type": "object", "additionalProperties": false,
      "required": ["logo", "logo_offset", "logo_resize", "base_color", "gradient", "text", "text_offset", "font", "font_color", "font_size", "out_name", "avg_color", "avg_color_image", "dom_color", "dom_color_image", "border", "border_width", "border_color", "white_wash", "clean"],
      "properties": {
        "logo": {"$ref": "#/$defs/nullablePath"}, "logo_offset": {"$ref": "#/$defs/offset"}, "logo_resize": {"type": "integer", "minimum": 0, "maximum": 2000},
        "base_color": {"$ref": "#/$defs/hex"}, "gradient": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "text": {"type": "string", "maxLength": 16384}, "text_offset": {"$ref": "#/$defs/offset"}, "font": {"$ref": "#/$defs/path"},
        "font_color": {"$ref": "#/$defs/hex"}, "font_size": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "out_name": {"$ref": "#/$defs/path"}, "avg_color": {"type": "boolean"}, "avg_color_image": {"$ref": "#/$defs/nullablePath"},
        "dom_color": {"type": "boolean"}, "dom_color_image": {"$ref": "#/$defs/nullablePath"}, "border": {"type": "boolean"},
        "border_width": {"type": "integer", "minimum": -1000000, "maximum": 1000000}, "border_color": {"$ref": "#/$defs/hex"}, "white_wash": {"type": "boolean"}, "clean": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "id": {"$ref": "#/$defs/id"}, "category": {"type": "string"}, "display_name": {"type": "string", "minLength": 1},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "line", "row_sha256"], "properties": {"kind": {"enum": ["legacy", "authored"]}, "path": {"$ref": "#/$defs/path"}, "line": {"type": ["integer", "null"], "minimum": 1}, "row_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}}},
    "composer": {"$ref": "#/$defs/composer"}, "caption": {"$ref": "#/$defs/caption"},
    "layout": {"type": "object", "additionalProperties": false, "required": ["kind", "measurement"], "properties": {"kind": {"enum": ["fixed", "captured_fit"]}, "measurement": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["text", "font_sha256", "point_size", "box", "minimum", "maximum", "evidence_sha256"], "properties": {"text": {"type": "string"}, "font_sha256": {"$ref": "#/$defs/sha"}, "point_size": {"type": "integer"}, "box": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}, "minimum": {"type": "integer"}, "maximum": {"type": "integer"}, "evidence_sha256": {"$ref": "#/$defs/sha"}}}]}}},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/language"}},
    "applicability": {"type": "object", "propertyNames": {"$ref": "#/$defs/language"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"enum": ["applicable", "not_applicable"]}, "reason": {"type": "string", "minLength": 1}}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["directory", "filename", "remote_paths"], "properties": {"directory": {"$ref": "#/$defs/path"}, "filename": {"$ref": "#/$defs/path"}, "remote_paths": {"type": "object", "propertyNames": {"$ref": "#/$defs/language"}, "additionalProperties": {"$ref": "#/$defs/nullablePath"}}}},
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["poster_id", "input"], "properties": {"poster_id": {"$ref": "#/$defs/id"}, "input": {"enum": ["logo", "avg_color_image"]}}}},
    "overrides": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["language", "changes"], "properties": {"language": {"$ref": "#/$defs/language"}, "changes": {"type": "object", "additionalProperties": false, "properties": {"composer": {"type": "object"}, "caption": {"type": "object"}, "layout": {"type": "object"}, "output": {"type": "object"}}}}}},
    "generator": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["name", "version", "parameters"], "properties": {"name": {"$ref": "#/$defs/id"}, "version": {"type": "integer", "minimum": 1}, "parameters": {"type": "object"}}}]},
    "color_assignment": {"type": "object", "additionalProperties": false, "required": ["id", "origin", "parent", "relationship", "exception"], "properties": {"id": {"$ref": "#/$defs/id"}, "origin": {"enum": ["historical", "independent", "inherited", "template"]}, "parent": {"type": ["string", "null"]}, "relationship": {"type": ["string", "null"]}, "exception": {"type": ["string", "null"]}}}
  }
}
