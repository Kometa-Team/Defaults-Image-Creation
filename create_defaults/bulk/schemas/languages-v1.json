{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kometa:bulk:languages:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "languages", "aliases", "provenance", "contribution"],
  "properties": {
    "schema_version": {"const": 1},
    "languages": {"type": "array", "maxItems": 1000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "native_code", "display_name", "resource", "sha256", "availability", "components", "font_support"],
      "properties": {
        "code": {"$ref": "urn:kometa:bulk:definition:1#/$defs/language"},
        "native_code": {"$ref": "urn:kometa:bulk:definition:1#/$defs/language"},
        "display_name": {"type": ["string", "null"], "maxLength": 256},
        "resource": {"type": ["string", "null"], "maxLength": 2048},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "size": {"type": "integer", "minimum": 0, "maximum": 8000000},
        "availability": {"enum": ["available", "unavailable", "not_discovered"]},
        "components": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}},
        "font_support": {"type": "string", "maxLength": 256}
      }
    }},
    "aliases": {"type": "object", "propertyNames": {"$ref": "urn:kometa:bulk:definition:1#/$defs/language"}, "additionalProperties": {"$ref": "urn:kometa:bulk:definition:1#/$defs/language"}},
    "provenance": {"type": "object"},
    "contribution": {"type": "object", "additionalProperties": false, "required": ["url", "level", "direct_key_available", "reason"], "properties": {
      "url": {"const": "https://translations.kometa.wiki/"}, "level": {"const": "landing"},
      "direct_key_available": {"const": false}, "reason": {"type": "string"}
    }}
  }
}
