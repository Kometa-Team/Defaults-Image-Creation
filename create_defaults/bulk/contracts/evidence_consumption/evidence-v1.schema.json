          "const": 1
        },
        "kind": {
          "const": "evidence-request-context"
        },
        "version": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "format": "phase3-id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
