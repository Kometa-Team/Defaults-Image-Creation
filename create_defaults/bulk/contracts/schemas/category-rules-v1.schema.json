{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kometa.wiki/schemas/lifecycle/category-rules-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "category",
    "version",
    "contract_sha256",
    "basis_sha256",
    "rules_json",
    "members_json",
    "provenance_json"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "category-contract-rules"
    },
    "category": {
      "$ref": "https://kometa.wiki/schemas/lifecycle/contract-v1.schema.json#/$defs/package/properties/category"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "not": {
        "pattern": "\\n"
      }
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "basis_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "rules_json": {
      "type": "string"
    },
    "members_json": {
      "type": "string"
    },
    "provenance_json": {
      "type": "string"
    }
  }
}
