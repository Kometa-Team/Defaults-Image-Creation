{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kometa.wiki/schemas/lifecycle/registry-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "category-contract-registry"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,199}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "not": {
        "pattern": "\\n"
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "provenance": {
      "$ref": "https://kometa.wiki/schemas/lifecycle/contract-v1.schema.json#/$defs/provenance"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "package": {
            "$ref": "https://kometa.wiki/schemas/lifecycle/contract-v1.schema.json#/$defs/package"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,199}$",
              "not": {
                "pattern": "\\n"
              }
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "approval_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "adoption_sha256": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "package",
          "variants",
          "approval_sha256",
          "adoption_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "owner",
    "provenance",
    "entries"
  ],
  "additionalProperties": false
}
